# GroupEat — Sprint 1 environment
# Copy to `.env` and fill in. `.env` is git-ignored; this file is the contract.
# Every key below is required unless marked optional. The app fails fast at boot
# with a readable message when a required key is missing (S1-007).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma (CLI and runtime).
# Local development: no password, current OS user.
DATABASE_URL="postgresql://bujin@localhost:5432/groupeat_dev"

# ---------------------------------------------------------------------------
# Session signing
# ---------------------------------------------------------------------------
# HS256 secret for the session JWT. Must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this value invalidates every active session.
JWT_SECRET="replace-me-with-a-32-plus-character-random-string"

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | test | production. `production` makes the session cookie Secure.
NODE_ENV="development"

# Absolute or repo-relative path for the append-only analytics log (JSONL).
# Optional; defaults to var/analytics/events.jsonl and is git-ignored.
ANALYTICS_LOG_PATH="var/analytics/events.jsonl"

# ---------------------------------------------------------------------------
# The copy model (M3) — all optional, and absence is a supported mode
# ---------------------------------------------------------------------------
# PRD-v1 §9.1.4: the deal builder must work with no model at all. When these are
# unset, `plan.ts` writes the proposal copy itself and the API reports
# `source: "planner"`. Nothing fails. An empty value (`AI_API_KEY=`) counts as
# unset, so a half-filled .env does not stop the app booting.
#
# Any OpenAI-compatible /chat/completions endpoint works; point AI_BASE_URL at a
# gateway, a local Ollama, or a proxy. The model is only ever asked to rewrite
# four string fields — never a price, a quantity or a date (docs/ADR-002).
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Seed bootstrap (used by `prisma/seed.ts` only)
# ---------------------------------------------------------------------------
# Temp password given to every seeded account. Merchants must change it on first
# login (mustChangePassword = true). Optional; defaults to the value below.
SEED_PASSWORD="GroupEat!2026"

# ---------------------------------------------------------------------------
# Stripe (M2 onboarding, M4 join, M5 capture) — optional, and absence disables
# ---------------------------------------------------------------------------
# ADR-001: direct charges on the merchant's connected account. The secret key
# below is the *platform's*; every money-touching call passes `{ stripeAccount }`
# via `forMerchant()` in `src/lib/payments/stripe.ts`. There is no second key for
# the merchant.
#
# Absence is a defined refusal, not a crash: Connect onboarding answers 503
# `STRIPE_NOT_CONFIGURED`, and the join route refuses before writing a row. The
# live Stripe suites skip with a named reason — a green test run is not evidence
# that a charge works.
#
# Test-mode values start `sk_test_…` / `pk_test_…`. Never put live keys in `.env`.
STRIPE_SECRET_KEY=""
# Used only by `POST /api/webhooks/stripe` to verify the signature on the raw body.
# Create the endpoint with `stripe listen --forward-to localhost:3001/api/webhooks/stripe`
# in development, or copy the signing secret from the Dashboard endpoint.
STRIPE_WEBHOOK_SECRET=""
# Publishable key for the Stripe Payment Element on the public join page.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# The cutoff job (M5) — optional, and its absence refuses the job
# ---------------------------------------------------------------------------
# Bearer token the scheduler presents to /api/jobs/cutoff. Unset means the route
# answers 503 { error: "NOT_CONFIGURED" } — a job that moves money must not be
# reachable without auth, so "not configured" is the safe default rather than an
# open endpoint. The token is compared in constant time.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# How the scheduler presents it, and why the method matters:
#
#   - Vercel Cron (`vercel.json`, schedule `* * * * *`) issues a **GET** and, when
#     CRON_SECRET is set on the project, attaches `Authorization: Bearer <value>`
#     itself. Nothing else needs configuring there — but the name has to be
#     exactly CRON_SECRET, because that is the variable the platform reads.
#   - Any other runner (Railway, a k8s CronJob, a laptop) should use **POST**,
#     which is the honest verb for an endpoint that mutates, with the same
#     `Authorization: Bearer <value>` header. Example:
#       curl -fsS -X POST https://<host>/api/jobs/cutoff \
#         -H "Authorization: Bearer $CRON_SECRET"
#
# The route exports both methods and they run one handler, so the two cannot
# diverge. See the docblock in `src/app/api/jobs/cutoff/route.ts` for why a GET
# that moves money was accepted.
#
# Local development: nothing runs the tick on a timer. Hit the endpoint by hand
# with `curl` (above) against `next dev`, or call `runCutoffTick` from a test.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Redemption-code signing (M5, FR-505) — optional
# ---------------------------------------------------------------------------
# HMAC key for the code a diner shows at the counter. Unset means it is derived
# from JWT_SECRET via HKDF-SHA256 with a fixed info string, so there is nothing
# to configure for development. Set it in production: while it is unset, rotating
# JWT_SECRET invalidates every code already printed (the job logs one warning at
# first use to say so).
REDEMPTION_SECRET=""

# ---------------------------------------------------------------------------
# Diner order-page token (M4 slice 2c, FR-408's link target) — optional
# ---------------------------------------------------------------------------
# HMAC key for the read-only `?t=` token on `/d/:publicCode/mine`. Unset means it
# is derived from JWT_SECRET via HKDF-SHA256 under a *different* info string than
# the redemption code's, so the two keys are not interchangeable — a leaked order
# link does not yield a redeemable code, which is the whole point of having two.
# Set it when links in an SMS must survive a session-secret rotation.
PARTICIPANT_ACCESS_SECRET=""

# ---------------------------------------------------------------------------
# The public origin for links in notifications (M4 slice 2c, FR-408) — optional
# ---------------------------------------------------------------------------
# The absolute origin the cutoff job puts in front of `/d/:publicCode/mine?t=…`
# when it emits a charged notification. Use the origin a **diner's phone** reaches,
# not an internal one:
#
#   APP_URL="https://groupeat.example"        # right
#   APP_URL="https://app.internal:8443"       # wrong — resolves only inside the VPC
#
# Unset means notifications carry the redemption code and **no link**. That is a
# supported mode, not a broken one: a message with no link is better than a message
# pointing at `localhost`, and the diner can still show the code at the counter.
#
# There is deliberately no fallback and no derivation from the incoming request.
# The job is invoked by a scheduler, so its `Host` header is whatever that scheduler
# sent — a container name, an internal address, or nothing. (The Stripe onboarding
# route does derive an origin from the request, and is right to: there the caller is
# the merchant's own browser. Different question, opposite answer.)
#
# A value that is set but unusable — `http://`, `localhost`, a loopback or bare IP,
# a `.local` mDNS name, a bare hostname — is refused with one `warn` log
# (`notify.public_origin_rejected`) and treated as unset. It does **not** stop the
# job: a misconfigured link is not a reason to leave due cards uncharged.
#
# Deliberately not prefixed `NEXT_PUBLIC_`: only this server-side job reads it, and
# a public prefix would inline the deployment's origin into every client bundle.
APP_URL=""


# ---------------------------------------------------------------------------
# SMS delivery (D-5, FR-408 and FR-506) — optional, with a defined fallback
# ---------------------------------------------------------------------------
# Decided in PRD-v1.md:1012: Twilio, with a verified Canadian sender ID. These are
# the three values `notify/twilio-sender.ts` reads; with any of them absent the app
# runs in **logging mode** — every message is composed and `{ kind, count }` is
# logged, and nothing is sent. That is a supported mode, not an error: a fresh
# checkout, a preview deployment and a test run all have no credentials.
#
# Partial configuration (an SID with no token) is treated as absent and logs
# `notification.sender_unconfigured` with the missing key names, because that state
# is almost always a typo in a deployment secret rather than a choice.
#
# `TWILIO_FROM_NUMBER` must be an E.164 number **provisioned in Canada**. A US long
# code will be filtered on delivery to Canadian handsets, and the failure is silent
# at our end — the API accepts the message and the carrier drops it.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

