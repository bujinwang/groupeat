// GroupEat — Prisma schema, Sprint 1
//
// Source of truth: PRD-v1 §5.1 plus the five accepted deltas D-1…D-5
// (docs/PRD-sprint1.md §8, docs/ARCHITECTURE-sprint1.md §3.5).
//
// Sprint 1 reads and writes: User, Merchant, MerchantUser, MenuItem,
// OrganiserProfile. Everything else is created by this migration so that no
// later migration has to restructure the graph (PRD-sprint1 §7.6) and must not
// be read or written by Sprint 1 code.
//
// The nine obsolete models of the previous repo were removed in full; PRD-v1
// §5.2 lists them by name. Nothing from that generation survives here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth accounts (staff, organisers, admin). NOT diners.
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(ORGANISER)
  createdAt    DateTime @default(now())

  // D-4 (P1): temporary-password bootstrap. Set true on every admin-created
  // account so the first login can only reach /change-password.
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?

  merchantUsers    MerchantUser[]
  organiser        OrganiserProfile?
  auditLogs        AuditLog[]
  digestDeliveries DigestDelivery[]
  passwordInvites  PasswordInvite[]

  @@index([role])
}

enum UserRole {
  ADMIN
  MERCHANT
  ORGANISER
}

// ---------------------------------------------------------------------------
// Diners. Phone-keyed, no login.
// ---------------------------------------------------------------------------

model Customer {
  id          String   @id @default(uuid())
  phone       String   @unique // E.164, normalised
  email       String?
  name        String?
  firstSeenAt DateTime @default(now())

  participants DropParticipant[]
}

// ---------------------------------------------------------------------------
// Merchant
// ---------------------------------------------------------------------------

model Merchant {
  id                 String         @id @default(uuid())
  name               String
  slug               String         @unique
  legalName          String?
  timezone           String         @default("America/Edmonton")
  stripeAccountId    String?        @unique
  onboardingComplete Boolean        @default(false)
  status             MerchantStatus @default(PENDING)

  // D-1 (P0): the merchant's minimum margin as a share of menu price. This is
  // the guardrail's `floorPctOfMenu` input. It arrives from Prisma as a Decimal
  // and must pass through MerchantRepo.toPct() before it reaches the pure module.
  floorPctOfMenu Decimal @default(0.25) @db.Decimal(5, 2)

  pickupAddress      String?
  pickupInstructions String?
  createdAt          DateTime @default(now())

  users            MerchantUser[]
  items            MenuItem[]
  drops            Drop[]
  shareLinks       ShareLink[]
  aiDrafts         AiDraft[]
  digestDeliveries DigestDelivery[]

  @@index([status])
}

enum MerchantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model MerchantUser {
  id         String       @id @default(uuid())
  merchantId String
  userId     String
  role       MerchantRole

  // FR-704 — express consent for the weekly merchant digest.
  //
  // On the membership rather than on `User`, because consent is to receive *this
  // merchant's* numbers at this address. A person who owns two restaurants can
  // reasonably want one digest and not the other, and a `User`-level flag would
  // take that choice away. `digestOptInAt` is the record of when the box was last
  // ticked; it is not a `ConsentRecord` row because that table is phone/email
  // keyed for diners and has no merchant or account dimension to withdraw against.
  digestOptIn   Boolean   @default(false)
  digestOptInAt DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@index([userId])
  @@index([merchantId, digestOptIn])
}

enum MerchantRole {
  OWNER
  MANAGER
  STAFF
}

// ---------------------------------------------------------------------------
// Menu item with cost data — the guardrail's input table.
// ---------------------------------------------------------------------------

model MenuItem {
  id             String  @id @default(uuid())
  merchantId     String
  name           String
  description    String?
  photoUrl       String?
  menuPriceCents Int // what it sells for normally
  foodCostCents  Int // ingredients only; non-nullable by design (PRD-sprint1 §8)
  packagingCents Int     @default(0)
  batchYield     Int // max units in one batch
  prepMinutes    Int?
  isBatchable    Boolean @default(true)

  // D-2 (P0): AGLC hard block. true means the item may never appear in a drop.
  containsAlcohol Boolean @default(false)

  // D-3 (P1): cuisine/category, needed later by `likelyFill`.
  category String?

  archivedAt DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  drops    Drop[]

  @@index([merchantId])
  @@index([merchantId, archivedAt])
}

// ---------------------------------------------------------------------------
// Organiser
// ---------------------------------------------------------------------------

model OrganiserProfile {
  id            String  @id @default(uuid())
  userId        String  @unique
  displayName   String
  phone         String?
  commissionPct Decimal @default(5.0) @db.Decimal(5, 2)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLinks ShareLink[]
}

// ---------------------------------------------------------------------------
// The Drop
// ---------------------------------------------------------------------------

model Drop {
  id           String  @id @default(uuid())
  merchantId   String
  menuItemId   String
  publicCode   String  @unique // short code for the URL: /d/{publicCode}
  title        String
  description  String?
  heroImageUrl String?

  dealPriceCents Int // per unit, what the diner pays
  minQty         Int
  maxQty         Int
  maxPerCustomer Int @default(4)

  windowStart DateTime // pickup window open
  windowEnd   DateTime // pickup window close
  cutoffAt    DateTime // join deadline == capture trigger

  status DropStatus @default(DRAFT)

  // Frozen snapshot of the guardrail maths at publish time. NEVER recomputed.
  // Shape: PRD-sprint1 §7.7. Written from M3 onward; empty in Sprint 1.
  guardrailSnapshot Json

  aiRationale String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  lockedAt    DateTime?
  completedAt DateTime?

  merchant     Merchant          @relation(fields: [merchantId], references: [id])
  menuItem     MenuItem          @relation(fields: [menuItemId], references: [id])
  participants DropParticipant[]
  shareLinks   ShareLink[]
  orders       Order[]

  @@index([merchantId, status])
  @@index([status, cutoffAt])
}

enum DropStatus {
  DRAFT
  PUBLISHED // accepting joins
  LOCKED // cutoff passed, threshold met, capture in progress
  CAPTURED // all captures settled
  PICKUP_OPEN // window open
  COMPLETED
  FAILED // threshold not met — all auths voided
  CANCELLED // merchant or admin cancelled
}

// ---------------------------------------------------------------------------
// Participants
// ---------------------------------------------------------------------------

model DropParticipant {
  id          String  @id @default(uuid())
  dropId      String
  customerId  String
  qty         Int
  shareLinkId String? // which organiser brought them

  // money
  paymentIntentId  String?      @unique
  amountCents      Int
  platformFeeCents Int
  authStatus       AuthStatus   @default(PENDING)
  chargeStatus     ChargeStatus @default(NONE)

  redemptionCode   String? // signed token, generated on capture
  redeemedQty      Int       @default(0)
  redeemedAt       DateTime?
  redeemedByUserId String?

  /** Per-scan idempotency records. See `model RedemptionScan`. */
  scans RedemptionScan[]

  createdAt DateTime @default(now())

  drop      Drop       @relation(fields: [dropId], references: [id], onDelete: Cascade)
  customer  Customer   @relation(fields: [customerId], references: [id])
  shareLink ShareLink? @relation(fields: [shareLinkId], references: [id])

  // D-5: the participant is the other half of the one-to-one Order relation.
  order Order?

  @@unique([dropId, customerId]) // one join per person per drop
  @@index([dropId, authStatus])
}

/**
 * One row per **submitted scan**, keyed by the client's idempotency key.
 *
 * ## Why this exists
 *
 * `redeemedQty` is incremented by `take`, so a per-unit redeem (`requested: 1`)
 * replayed after a lost response took a second plate. Measured against real
 * Postgres before this table existed: first scan → `redeemedQty = 1`, replayed
 * scan → `redeemedQty = 2`. A whole-order scan was accidentally safe (a replay
 * sees `remaining = 0` and answers `ALREADY_REDEEMED`) but per-unit is not, and a
 * flaky network is exactly the condition FR-606 exists for.
 *
 * ## Why the key is `scanId` and not the redemption code
 *
 * The code identifies *the order*, not *the attempt*. Two staff members scanning
 * the same code at two counters are two legitimate scans of one order, and each
 * must take its own units. Keying on the code would make the second one a no-op.
 * The client generates one `scanId` per human scan and reuses it across retries,
 * which is the distinction that is actually wanted.
 *
 * ## Why the row is written inside the claim transaction
 *
 * The insert and the `UPDATE … redeemedQty` have to commit or fail together. If the
 * insert committed first and the claim then failed, a retry would find the key and
 * answer "already redeemed" for plates that were never handed over. Written inside
 * `claimUnits`' transaction, a rollback drops both, and the retry re-does the work
 * honestly. `@@unique([participantId, scanId])` is the arbiter: the second insert
 * of the same key raises `P2002`, and that is how a replay is detected without a
 * read-then-write race.
 *
 * ## Retention
 *
 * Rows are kept with the participant (`onDelete: Cascade`). They are small — one
 * short string and two ids — and they are the only record of which scan took which
 * units, which is what a disputed handover turns on.
 */
model RedemptionScan {
  id            String   @id @default(uuid())
  participantId String
  /// The client's idempotency key: one per human scan, stable across retries.
  scanId        String
  /// Units this scan actually took. A replay returns the same number.
  taken         Int
  userId        String
  createdAt     DateTime @default(now())

  participant DropParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, scanId])
  @@index([participantId])
}

enum AuthStatus {
  PENDING
  AUTHORIZED
  FAILED
  VOIDED
  EXPIRED
}

enum ChargeStatus {
  NONE
  CAPTURED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

// ---------------------------------------------------------------------------
// Organiser share links (attribution)
// ---------------------------------------------------------------------------

model ShareLink {
  id          String   @id @default(uuid())
  token       String   @unique // /d/{publicCode}?o={token}
  dropId      String
  merchantId  String
  organiserId String
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  drop         Drop              @relation(fields: [dropId], references: [id], onDelete: Cascade)
  merchant     Merchant          @relation(fields: [merchantId], references: [id])
  organiser    OrganiserProfile  @relation(fields: [organiserId], references: [id])
  participants DropParticipant[]

  @@unique([dropId, organiserId])
  @@index([dropId])
  @@index([organiserId])
}

// ---------------------------------------------------------------------------
// Orders & ledger
// ---------------------------------------------------------------------------

model Order {
  id               String   @id @default(uuid())
  dropId           String
  participantId    String   @unique
  qty              Int
  unitPriceCents   Int
  subtotalCents    Int
  platformFeeCents Int
  stripeChargeId   String?
  createdAt        DateTime @default(now())

  // What has actually gone back, in cents, accumulating across refunds. FR-903
  // permits a partial refund, so "refunded" is a quantity and not a flag — the
  // same reason `ChargeStatus.PARTIALLY_REFUNDED` exists.
  //
  // These two columns exist so the ledger's identities have something to be
  // checked AGAINST. L1–L4 compare the `LedgerEntry` rows to the `Order` rows, so
  // if the ledger were also the store for the refund amount, each identity would
  // be asserting a value against itself and could never fail. Two records of one
  // fact, written in one transaction, required to agree — that is the check.
  //
  // `platformFeeReversedCents` is deliberately its own column rather than a
  // derived fraction of `refundedCents`. Stripe's docs say a partial refund
  // reverses "a proportional amount of the application fee" and never state the
  // rounding, so the amount we must record is the one Stripe reports on the
  // `ApplicationFee` — see `ChargePort.refund`'s `applicationFeeRefundCents`.
  // Computing it here would be inventing a number we are not permitted to invent.
  refundedCents            Int @default(0)
  platformFeeReversedCents Int @default(0)

  drop        Drop            @relation(fields: [dropId], references: [id], onDelete: Cascade)
  // D-5 (P1): a real relation, so an Order cannot point at a participant that
  // does not exist. Previously a bare `String @unique` with no foreign key.
  participant DropParticipant @relation(fields: [participantId], references: [id])

  @@index([dropId])
}

// The money trail. Written by settlement only (M5); read by reconciliation (M8).
//
// @@unique([orderId, type]) is the idempotency guard (M5 design §4.2, §5). Postgres
// treats NULLs as distinct in a unique index, so drop-level rows (orderId IS NULL)
// are unconstrained, which is what we want. The consequence, stated so nobody is
// surprised by a constraint violation later: **V1 permits at most one CHARGE, one
// PLATFORM_FEE, one REFUND and one ADJUSTMENT per order.**
//
// FR-903 (M8) has now reached that consequence rather than a hypothetical: a
// partial refund writes ONE REFUND and ONE ADJUSTMENT row, so a *second* refund on
// the same order would violate the index. The decision taken, and why it is the
// conservative one: **V1 permits one refund per order**, of any amount up to the
// remainder. `issueParticipantRefund` refuses a second refund explicitly and says
// so, rather than letting the index throw a Prisma error that reads like a bug. A
// refund that must be corrected upward — refunded too little — is a manual action
// in the Stripe dashboard plus a reconciliation note, which is the honest state for
// a product that has not yet needed it twice.
//
// Deliberately NOT added: foreign keys from orderId/dropId. They are nullable, they
// have no relation today, and adding them is a wider migration than M5 needs. The
// unique index gives the idempotency; referential integrity can arrive with M8.
//
// Note for L5 (M5 design §6.3, open question 8): this model has **no account
// dimension**. Under ADR-001's direct charges one drop moves money on two Stripe
// accounts (the merchant's, and ours for the application fee), and L5's nightly
// reconciliation has to know which account each entry belongs to. A field naming
// the Stripe account must be decided and added **before** the M8 nightly job is
// written — not after, when the entries already exist without it and cannot be
// attributed retroactively.
model LedgerEntry {
  id          String     @id @default(uuid())
  orderId     String?
  dropId      String?
  type        LedgerType
  amountCents Int // signed: +credit to platform, -debit
  stripeRef   String?
  note        String?
  createdAt   DateTime   @default(now())

  @@unique([orderId, type])
  @@index([dropId])
}

enum LedgerType {
  CHARGE
  REFUND
  PLATFORM_FEE
  ORGANISER_COMMISSION
  ADJUSTMENT
}

// ---------------------------------------------------------------------------
// AI audit
// ---------------------------------------------------------------------------

/// FR-905 — the raw AI runs, kept as evidence for a merchant complaint.
///
/// ## Why `merchantId` is nullable and `SetNull`
///
/// This row is an *audit* record, and the repo already settled what that means:
/// `AuditLog` sets `actorUserId` to `SetNull` and keeps `actorEmail` denormalised, so
/// the record survives the deletion of the thing it names. `AiDraft` follows the same
/// shape for the same reason — `Cascade` would delete the evidence when the merchant
/// goes, which is the opposite of an audit trail, and `Restrict` would make a merchant
/// that ever asked for proposals permanent.
///
/// `merchantName` is the `actorEmail` of this table: captured at write time, so a row
/// whose merchant is gone can still say who it was about. Without it, `SetNull` would
/// blank the only human-readable pointer to the subject and leave the admin screen
/// rendering a bare uuid.
///
/// The migration that added the constraint measured zero orphans first — the loader
/// was written to tolerate them, but none existed.
model AiDraft {
  id              String   @id @default(uuid())
  /// Null once the merchant is deleted. See the model docblock.
  merchantId      String?
  /// The merchant's name **as it stood when the row was written**. Never updated;
  /// renaming a merchant does not rewrite history.
  merchantName    String?
  surface         String // "merchant_builder" | "organiser_assistant"
  promptVersion   String
  inputJson       Json
  outputJson      Json
  guardrailPassed Boolean
  accepted        Boolean?
  createdAt       DateTime @default(now())

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([merchantId])
}

// ---------------------------------------------------------------------------
// CASL consent trail
// ---------------------------------------------------------------------------

model ConsentRecord {
  id          String       @id @default(uuid())
  phone       String?
  email       String?
  basis       ConsentBasis // EXPRESS | IMPLIED_TRANSACTION
  source      String // "drop_join" | "organiser_invite"
  grantedAt   DateTime     @default(now())
  withdrawnAt DateTime?
  ipAddress   String?

  @@index([phone])
}

enum ConsentBasis {
  EXPRESS
  IMPLIED_TRANSACTION
}

// ---------------------------------------------------------------------------
// Audit log — FR-902, FR-904
// ---------------------------------------------------------------------------

// The record of who did something irreversible, to what, and why.
//
// ## Why this is append-only by discipline rather than by grant
//
// Nothing in `src/` may update or delete an `AuditLog` row. Postgres could enforce
// that with a revoked grant, and should once this is deployed with a dedicated
// application role; in V1 the guarantee is the module boundary — `lib/audit/log.ts`
// exposes `writeAuditEntry` and no mutator, and there is no `prisma.auditLog.update`
// call in the repo. A test asserts that, because a convention with no test is a
// convention until the first convenient exception.
//
// ## Why `actorEmail` is denormalised
//
// `actorUserId` is the foreign key and is the truth. But a `User` row can be
// renamed, and the question an auditor asks in eighteen months is "who did this at
// the time", not "what is that account called now". Storing the email as it was
// makes the row readable on its own and survives the user being deleted, which is
// why the relation is `onDelete: SetNull` rather than cascade: deleting a user must
// not erase the record of what they did.
//
// ## Why there is no `drop` or `participant` relation
//
// `targetId` is a plain string. An audit trail whose rows disappear when the thing
// they describe is deleted is not an audit trail — a force-failed drop that is later
// hard-deleted must still have a record saying somebody forced it. `targetType` says
// how to read the id; `detail` carries the facts that mattered at the time, such as
// the quantity refunded.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  /// The actor's email at the time of the action. Denormalised on purpose.
  actorEmail  String
  action      String // "drop.force_fail" | "participant.refund" | "session.impersonate"
  targetType  String // "drop" | "participant" | "user"
  targetId    String
  /// Free-form context as it stood: quantities, amounts, the operator's reason.
  detail      Json
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([actorUserId])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// FR-704 — the weekly digest, sent once per owner per week
// ---------------------------------------------------------------------------

/// One successful delivery of one week's digest to one owner.
///
/// ## Why the idempotency key is `(merchantId, userId, weekStart)`
///
/// The digest is a cron job and cron jobs get retried. The scheduler may run twice
/// after a deploy, a human may `curl` the route to test it, and the interval between
/// those invocations must not produce two emails. The unique index is the guarantee:
/// a row exists only after the provider accepted the message, and a second run sees
/// it and skips. `weekStart` is the **local** Monday 00:00 instant, so the key is the
/// period the email describes rather than the moment it was sent.
///
/// A failed send writes no row, which is deliberate: the next invocation should try
/// again. The trade-off is that a crash after the provider accepted but before the
/// row was written can duplicate one email. That is the right way to be wrong for a
/// digest — a missing Monday email is invisible, and a duplicate is merely annoying.
model DigestDelivery {
  id         String   @id @default(uuid())
  merchantId String
  userId     String
  /// The instant local Monday 00:00 begins the week this digest covers.
  weekStart  DateTime
  sentAt     DateTime @default(now())
  /// The provider's message id, when it returned one. Never required.
  providerId String?

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId, weekStart])
  @@index([weekStart])
}

// ---------------------------------------------------------------------------
// FR-101 — the set-password invitation
// ---------------------------------------------------------------------------

/// A one-time link that lets an admin-created owner choose their own password.
///
/// ## Why the token is stored hashed
///
/// The link is a bearer credential. A database read — a backup, a support query, a
/// leaked `DATABASE_URL` — must not be enough to take over an account. The stored
/// value is SHA-256 of the token, and the plaintext exists only in the email. A
/// fast hash is the right tool here rather than bcrypt: the token is 32 random
/// bytes, so there is no dictionary to stretch against, and the lookup is by hash
/// on every attempt.
///
/// ## Why `userId` is not unique
///
/// Re-inviting invalidates the previous link by setting `usedAt`, then inserts a new
/// row. Keeping the history answers "which link was used, and when" without a second
/// table, and the old rows are inert because the consume predicate requires
/// `usedAt: null`.
///
/// ## Why the accept is one transaction
///
/// `setPasswordWithInvite` claims the row with a conditional `updateMany` and only
/// then writes the password. Two taps on "Set password" race on that condition, and
/// exactly one wins; the loser gets the same "invalid or expired" sentence as a
/// stranger with a stale link.
model PasswordInvite {
  id        String    @id @default(uuid())
  userId    String
  /// SHA-256 of the 32-byte token. Never the token itself.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}
